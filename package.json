{
  "name": "elevanceskills-mern-platform",
  "version": "1.0.0",
  "private": true,
  "description": "MERN video platform internship project",
  "scripts": {
    "install:all": "npm --prefix client install && npm --prefix server install",
    "dev": "concurrently -n client,server -c blue,green \"npm:dev:client\" \"npm:dev:server\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm --prefix client run build",
    "start": "npm --prefix server start"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
